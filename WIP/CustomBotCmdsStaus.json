  "example": "!runcollector",
  "script": "/home/steam/jtwp-collector/Pavlov-Data-Collector-/scripts/run-collector.sh",
  "script_arguments": [],
  "sudo": true,
  "file_bridge": {
    "enabled": true,
    "input_file": "IN-runcollector.json",
    "output_file": "OUT-runcollector.json",
    "example_input": {}
  },
  "notes": "Loads /home/steam/jtwp-collector/Pavlov-Data-Collector-/.env before running collector.py with the JTWP virtual environment. Requires the matching NOPASSWD sudoers rule for run-collector.sh."
}

    "runpavlovapi": {
      "working": true,
