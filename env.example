# JTWP Pavlov Data Collector environment variables
# Copy this file to .env and replace the example values.
#
#   cp .env.example .env
#   chmod 600 .env
#
# NEVER commit your real .env file to Git.

# Required: stable secret used to HMAC-SHA256 hash IP addresses.
# Generate one with:
#   openssl rand -hex 32
#
# IMPORTANT: Once you begin collecting data, do not change this secret.
JTWP_IP_HASH_SECRET=replace_with_a_long_random_secret

# IP enrichment
PROXYCHECK_API_KEY=replace_with_proxycheck_api_key
# go to https://proxycheck.io/ to sign up for free api key 

# Mod.io metadata lookup
MODIO_API_KEY=replace_with_modio_api_key

# Player connection alerts
JTWP_CONNECTION_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME

# Shared security webhook.
# Used for SSH failures and failed RCON authentication unless a dedicated
# webhook below is configured.
JTWP_SECURITY_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME

# Optional dedicated security webhooks.
# If set, these override JTWP_SECURITY_WEBHOOK_URL for that event type.
# JTWP_SSH_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME
# JTWP_RCON_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME
