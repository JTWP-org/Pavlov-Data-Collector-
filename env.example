# KEEP THIS SECRET.
FINDIP_API_KEY=""

# IPHub API key.
# Used as an additional IP intelligence provider for VPN/proxy,
# Tor, hosting/datacenter detection, and country information.
# KEEP THIS SECRET.
IPHUB_API_KEY=""

# Current IP lookup fallback order:
#
#   1. ProxyCheck
#   2. FindIP
#   3. IPHub
#   4. ip-api.com
#   5. FreeIPAPI
#
# ip-api.com and FreeIPAPI do not require API keys in our setup.

# IPAPI_API_KEY is no longer used.
# ipapi.is has been removed from the JTWP lookup chain.


JTWP_RCON_STATUS_WEBHOOK_URL=""
JTWP_RCON_COMMAND_WEBHOOK_URL=""

JTWP_SSH_STATUS_WEBHOOK_URL=""



{
  "rcon_inspect_loop": {
    "enabled": true,
    "minimum_players": 2,
    "poll_interval_seconds": 5,
    "timeout_seconds": 8,
    "record_ping_samples": true
  },
  "rcon_security": {
    "enabled": true,
    "rate_window_seconds": 60,
    "elevated_rate": 3,
    "high_rate": 6,
    "critical_rate": 11,
    "attack_rate": 21,
    "auto_block_enabled": true,
    "block_after_failures": 5,
    "block_window_seconds": 60,
    "block_command": "/usr/local/bin/block-ip",
    "block_use_sudo": true,
    "discord_status_interval_seconds": 30,
    "command_webhook_exclude": ["InspectAll", "ServerInfo", "RefreshList"]
  },
  "ssh_watcher": {
    "auto_block_enabled": true,
    "auto_block_after": 4,
    "auto_block_command": "/usr/local/bin/block-ip",
    "auto_block_use_sudo": true,
    "discord_status_interval_seconds": 30
  }
}
