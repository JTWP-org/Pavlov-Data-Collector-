    "setbalancetableurl": {
      "rcon_command": "SetBalanceTableURL",
      "supported": true,
      "description": "Sets the balance table to load from the specified URL.",
      "args": [
        {
          "name": "github_url",
          "type": "string",
          "required": true
        }
      ],
      "notes": [
        "The URL format is user/repo/branch and must contain BalancingTable.csv.",
        "Full http/https URLs do not work.",
        "Writes to BalanceTableURL in Game.ini."
      ],
      "example": "SetBalanceTableURL vankruptgames/BalancingTable/Beta_5.1",
      "requires_args": true,
      "input_file": "IN-setbalancetableurl.json",
      "output_file": "OUT-setbalancetableurl.json"
