{
  "version": 1,
  "description": "JTWP custom/local command definitions",
  "commands": {
    "restartjtwp": {
      "type": "local",
      "enabled": true,
      "allow_file_bridge": true,
      "owner_only": true,
      "description": "Restarts all JTWP collector services.",
      "command": "/usr/local/bin/restart-jtwp",
      "command_args": [],
      "use_sudo": true,
      "detached": true,
      "timeout_seconds": 120,
      "args": [],
      "requires_args": false,
      "input_file": "IN-restartjtwp.json",
      "output_file": "OUT-restartjtwp.json",
      "accepted_message": "JTWP restart accepted; services may disconnect briefly."
    },
    "exportdata": {
      "type": "local",
      "enabled": true,
      "allow_file_bridge": true,
      "owner_only": true,
      "description": "Exports and compresses the JTWP collector data.",
      "command": "/home/steam/jtwp-collector/venv/bin/python3",
      "command_args": [
        "-u",
        "/home/steam/jtwp-collector/Pavlov-Data-Collector-/scripts/export-data.py"
      ],
      "use_sudo": false,
      "detached": false,
      "timeout_seconds": 1800,
      "args": [],
      "requires_args": false,
      "input_file": "IN-exportdata.json",
      "output_file": "OUT-exportdata.json"
    },
    "backupdata": {
      "type": "local",
      "enabled": true,
      "allow_file_bridge": true,
      "owner_only": true,
      "description": "Creates a timestamped backup of JTWP collector data.",
      "command": "/home/steam/jtwp-collector/venv/bin/python3",
      "command_args": [
        "-u",
        "/home/steam/jtwp-collector/Pavlov-Data-Collector-/scripts/backup-data.py"
      ],
      "use_sudo": false,
      "detached": false,
      "timeout_seconds": 1800,
      "args": [],
      "requires_args": false,
      "input_file": "IN-backupdata.json",
      "output_file": "OUT-backupdata.json"
    },
    "cleardata": {
      "type": "local",
      "enabled": true,
      "allow_file_bridge": true,
      "owner_only": true,
      "description": "Clears JTWP collector data.",
      "command": "/home/steam/jtwp-collector/Pavlov-Data-Collector-/scripts/clear-data.sh",
      "command_args": [
        "--yes"
      ],
      "use_sudo": true,
      "detached": false,
      "timeout_seconds": 300,
      "args": [],
      "requires_args": false,
      "input_file": "IN-cleardata.json",
      "output_file": "OUT-cleardata.json"
    },
    "clearpavlovmods": {
      "type": "local",
      "enabled": true,
      "allow_file_bridge": true,
      "owner_only": true,
      "description": "Clears downloaded Pavlov mods for a selected server.",
      "command": "/usr/local/bin/clear-pavlov-mods",
      "command_args": [],
      "use_sudo": true,
      "detached": false,
      "timeout_seconds": 600,
      "args": [
        "server"
      ],
      "requires_args": true,
      "input_file": "IN-clearpavlovmods.json",
      "output_file": "OUT-clearpavlovmods.json"
    },
    "runcollector": {
      "type": "local",
      "enabled": true,
      "allow_file_bridge": true,
      "owner_only": true,
      "description": "Runs the JTWP Pavlov data collector.",
      "command": "/home/steam/jtwp-collector/venv/bin/python3",
      "command_args": [
        "/home/steam/jtwp-collector/Pavlov-Data-Collector-/collector.py",
        "-c",
        "/home/steam/jtwp-collector/Pavlov-Data-Collector-/config.json"
      ],
      "use_sudo": false,
      "detached": false,
      "timeout_seconds": 600,
      "args": [],
      "requires_args": false,
      "input_file": "IN-runcollector.json",
      "output_file": "OUT-runcollector.json"
    },
    "runpavlovapi": {
      "type": "local",
      "enabled": true,
      "allow_file_bridge": true,
      "owner_only": true,
      "description": "Updates the JTWP Pavlov public API data.",
      "command": "/home/steam/jtwp-collector/venv/bin/python3",
      "command_args": [
        "/home/steam/jtwp-collector/Pavlov-Data-Collector-/update_pavlov_api.py",
        "-c",
        "/home/steam/jtwp-collector/Pavlov-Data-Collector-/config.json"
      ],
      "use_sudo": false,
      "detached": false,
      "timeout_seconds": 600,
      "args": [],
      "requires_args": false,
      "input_file": "IN-runpavlovapi.json",
      "output_file": "OUT-runpavlovapi.json"
    },
    "runssh": {
      "type": "local",
      "enabled": true,
      "allow_file_bridge": true,
      "owner_only": true,
      "description": "Builds and sends the JTWP SSH report.",
      "command": "/bin/bash",
      "command_args": [
        "-c",
        "bash /home/steam/jtwp-collector-data/global/ssh/buildIt > /home/steam/jtwp-collector-data/global/ssh/built.txt && bash /home/steam/jtwp-collector-data/global/ssh/discordIt"
      ],
      "use_sudo": false,
      "detached": false,
      "timeout_seconds": 600,
      "args": [],
      "requires_args": false,
      "input_file": "IN-runssh.json",
      "output_file": "OUT-runssh.json"
    },
    "liveservers": {
      "type": "local",
      "enabled": true,
      "allow_file_bridge": true,
      "owner_only": false,
      "description": "Builds and posts the Pavlov live server list as Discord text embeds.",
      "command": "/home/steam/jtwp-collector/Pavlov-Data-Collector-/scripts/servers/LIVEserversArray.sh",
      "command_args": [],
      "use_sudo": false,
      "detached": false,
      "timeout_seconds": 300,
      "args": [],
      "requires_args": false,
      "input_file": "IN-liveservers.json",
      "output_file": "OUT-liveservers.json"
    },
    "liveserversimg": {
      "type": "local",
      "enabled": true,
      "allow_file_bridge": true,
      "owner_only": false,
      "description": "Builds and posts the Pavlov live server browser image.",
      "command": "/home/steam/jtwp-collector/Pavlov-Data-Collector-/scripts/servers/LIVEserversIMG.sh",
      "command_args": [],
      "use_sudo": false,
      "detached": false,
      "timeout_seconds": 300,
      "args": [],
      "requires_args": false,
      "input_file": "IN-liveserversimg.json",
      "output_file": "OUT-liveserversimg.json"
    }
  }
}
