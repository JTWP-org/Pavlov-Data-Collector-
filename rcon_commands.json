{
  "version": 1,
  "description": "JTWP Pavlov RCON file-bridge command definitions.",
  "input_prefix": "IN-",
  "output_prefix": "OUT-",
  "file_extension": ".json",
  "commands": {
    "addmaprotation": {
      "rcon_command": "AddMapRotation",
      "supported": true,
      "description": "Adds the specified map with the specified game mode to the bottom of the map rotation.",
      "args": [
        {
          "name": "map_name_or_id",
          "type": "string",
          "required": true
        },
        {
          "name": "game_mode",
          "type": "string",
          "required": true
        }
      ],
      "notes": [
        "Writes the map to Game.ini."
      ],
      "example": "AddMapRotation sand snd",
      "requires_args": true,
      "input_file": "IN-addmaprotation.json",
      "output_file": "OUT-addmaprotation.json"
    },
    "addmod": {
      "rcon_command": "AddMod",
      "supported": true,
      "description": "Adds the specified player to the moderator list, making them an admin.",
      "args": [
        {
          "name": "unique_id",
          "type": "string",
          "required": true
        }
      ],
      "notes": [
        "Allows the player to use the admin menu in the pause menu.",
        "Makes the player immune to being vote-kicked.",
        "Writes the player to mods.txt."
      ],
      "example": "AddMod 12345678901234567",
      "requires_args": true,
      "input_file": "IN-addmod.json",
      "output_file": "OUT-addmod.json"
    },
    "ban": {
      "rcon_command": "Ban",
      "supported": true,
      "description": "Kicks and permanently bans the specified player from the server.",
      "args": [
        {
          "name": "unique_id",
          "type": "string",
          "required": true
        }
      ],
      "notes": [
        "Writes the player to blacklist.txt."
      ],
      "example": "Ban 12345678901234567",
      "requires_args": true,
      "input_file": "IN-ban.json",
      "output_file": "OUT-ban.json"
    },
    "banlist": {
      "rcon_command": "Banlist",
      "supported": true,
      "description": "Lists the currently banned player UniqueIDs from blacklist.txt.",
      "args": [],
      "notes": [],
      "example": "Banlist",
      "requires_args": false,
      "input_file": "IN-banlist.json",
      "output_file": "OUT-banlist.json"
    },
    "clearemptyvehicles": {
      "rcon_command": "ClearEmptyVehicles",
      "supported": true,
      "description": "Removes all vehicles that are not occupied by a player.",
      "args": [],
      "notes": [],
      "example": "ClearEmptyVehicles",
      "requires_args": false,
      "input_file": "IN-clearemptyvehicles.json",
      "output_file": "OUT-clearemptyvehicles.json"
    },
    "disconnect": {
      "rcon_command": "Disconnect",
      "supported": true,
      "description": "Forces the server to close the RCON connection.",
      "args": [],
      "notes": [
        "Expected response is Goodbye."
      ],
      "example": "Disconnect",
      "requires_args": false,
      "input_file": "IN-disconnect.json",
      "output_file": "OUT-disconnect.json"
    },
    "enablecompmode": {
      "rcon_command": "EnableCompMode",
      "supported": true,
      "description": "Enables or disables competitive mode.",
      "args": [
        {
          "name": "enabled",
          "type": "boolean",
          "required": true
        }
      ],
      "notes": [
        "Competitive mode is changed on map rotation; this command updates the config value.",
        "Writes to bCompetitive in Game.ini."
      ],
      "example": "EnableCompMode true",
      "requires_args": true,
      "input_file": "IN-enablecompmode.json",
      "output_file": "OUT-enablecompmode.json"
    },
    "enableverboselogging": {
      "rcon_command": "EnableVerboseLogging",
      "supported": true,
      "description": "Enables or disables verbose logging.",
      "args": [
        {
          "name": "enabled",
          "type": "boolean",
          "required": true
        }
      ],
      "notes": [
        "Writes to bVerboseLogging in Game.ini."
      ],
      "example": "EnableVerboseLogging false",
      "requires_args": true,
      "input_file": "IN-enableverboselogging.json",
      "output_file": "OUT-enableverboselogging.json"
    },
    "enablewhitelist": {
      "rcon_command": "EnableWhitelist",
      "supported": true,
      "description": "Enables or disables whitelist usage.",
      "args": [
        {
          "name": "enabled",
          "type": "boolean",
          "required": true
        }
      ],
      "notes": [
        "When enabled, only players listed in whitelist.txt can join the server.",
        "Writes to bWhitelist in Game.ini."
      ],
      "example": "EnableWhitelist true",
      "requires_args": true,
      "input_file": "IN-enablewhitelist.json",
      "output_file": "OUT-enablewhitelist.json"
    },
    "gag": {
      "rcon_command": "Gag",
      "supported": true,
      "description": "Gags or ungags the specified player.",
      "args": [
        {
          "name": "unique_id",
          "type": "string",
          "required": true
        },
        {
          "name": "enabled",
          "type": "boolean",
          "required": true
        }
      ],
      "notes": [
        "When gagged, the player cannot use voice chat."
      ],
      "example": "Gag 12345678901234567 true",
      "requires_args": true,
      "input_file": "IN-gag.json",
      "output_file": "OUT-gag.json"
    },
    "giveall": {
      "rcon_command": "GiveAll",
      "supported": true,
      "description": "Gives an item to all players on a team.",
      "args": [
        {
          "name": "team_id",
          "type": "integer",
          "required": true
        },
        {
          "name": "item_id",
          "type": "string",
          "required": true
        }
      ],
      "notes": [
        "Item placement follows the same behavior described for GiveItem."
      ],
      "example": "GiveAll 1 galul",
      "requires_args": true,
      "input_file": "IN-giveall.json",
      "output_file": "OUT-giveall.json"
    },
    "givecash": {
      "rcon_command": "GiveCash",
      "supported": true,
      "description": "Gives the specified amount of cash to the specified player.",
      "args": [
        {
          "name": "unique_id",
          "type": "string",
          "required": true
        },
        {
          "name": "cash_amount",
          "type": "integer",
          "required": true
        }
      ],
      "notes": [],
      "example": "GiveCash 12345678901234567 200",
      "requires_args": true,
      "input_file": "IN-givecash.json",
      "output_file": "OUT-givecash.json"
    },
    "giveitem": {
      "rcon_command": "GiveItem",
      "supported": true,
      "description": "Equips the specified item to the specified player in the corresponding item slot.",
      "args": [
        {
          "name": "unique_id",
          "type": "string",
          "required": true
        },
        {
          "name": "item_id",
          "type": "string",
          "required": true
        }
      ],
      "notes": [
        "Primary guns are placed into the player's main hand, replacing and dropping the held gun.",
        "Secondary guns are placed onto the player's hip, replacing and dropping the holstered gun.",
        "Utilities are placed into chest slots until full; additional items are dropped."
      ],
      "example": "GiveItem 12345678901234567 syringe",
      "requires_args": true,
      "input_file": "IN-giveitem.json",
      "output_file": "OUT-giveitem.json"
    },
    "giveteamcash": {
      "rcon_command": "GiveTeamCash",
      "supported": true,
      "description": "Adds the specified amount of cash to each member of the specified team.",
      "args": [
        {
          "name": "team_id",
          "type": "integer",
          "required": true
        },
        {
          "name": "cash_amount",
          "type": "integer",
          "required": true
        }
      ],
      "notes": [],
      "example": "GiveTeamCash 0 200",
      "requires_args": true,
      "input_file": "IN-giveteamcash.json",
      "output_file": "OUT-giveteamcash.json"
    },
    "help": {
      "rcon_command": "Help",
      "supported": true,
      "description": "Returns the full list of commands and their parameters.",
      "args": [],
      "notes": [],
      "example": "Help",
      "requires_args": false,
      "input_file": "IN-help.json",
      "output_file": "OUT-help.json"
    },
    "inspectall": {
      "rcon_command": "InspectAll",
      "supported": true,
      "description": "Returns a list of InspectPlayer blocks for all players on the server.",
      "args": [],
      "notes": [],
      "example": "InspectAll",
      "requires_args": false,
      "input_file": "IN-inspectall.json",
      "output_file": "OUT-inspectall.json"
    },
    "inspectplayer": {
      "rcon_command": "InspectPlayer",
      "supported": true,
      "description": "Returns a detailed status for the specified player.",
      "args": [
        {
          "name": "unique_id",
          "type": "string",
          "required": true
        }
      ],
      "notes": [
        "The player must be listed in RefreshList."
      ],
      "example": "InspectPlayer 12345678901234567",
      "requires_args": true,
      "input_file": "IN-inspectplayer.json",
      "output_file": "OUT-inspectplayer.json"
    },
    "inspectteam": {
      "rcon_command": "InspectTeam",
      "supported": true,
      "description": "Returns a list of InspectPlayer blocks for all players on the specified team.",
      "args": [
        {
          "name": "team_id",
          "type": "integer",
          "required": true
        }
      ],
      "notes": [],
      "example": "InspectTeam 1",
      "requires_args": true,
      "input_file": "IN-inspectteam.json",
      "output_file": "OUT-inspectteam.json"
    },
    "itemlist": {
      "rcon_command": "ItemList",
      "supported": true,
      "description": "Lists all items in the game and the current map.",
      "args": [],
      "notes": [
        "Custom items built into the map will be listed."
      ],
      "example": "ItemList",
      "requires_args": false,
      "input_file": "IN-itemlist.json",
      "output_file": "OUT-itemlist.json"
    },
    "kick": {
      "rcon_command": "Kick",
      "supported": true,
      "description": "Kicks the specified player from the server.",
      "args": [
        {
          "name": "unique_id",
          "type": "string",
          "required": true
        }
      ],
      "notes": [],
      "example": "Kick 12345678901234567",
      "requires_args": true,
      "input_file": "IN-kick.json",
      "output_file": "OUT-kick.json"
    },
    "kill": {
      "rcon_command": "Kill",
      "supported": true,
      "description": "Kills the specified player.",
      "args": [
        {
          "name": "unique_id",
          "type": "string",
          "required": true
        }
      ],
      "notes": [],
      "example": "Kill 12345678901234567",
      "requires_args": true,
      "input_file": "IN-kill.json",
      "output_file": "OUT-kill.json"
    },
    "maplist": {
      "rcon_command": "MapList",
      "supported": true,
      "description": "Returns the current map rotation from Game.ini.",
      "args": [],
      "notes": [],
      "example": "MapList",
      "requires_args": false,
      "input_file": "IN-maplist.json",
      "output_file": "OUT-maplist.json"
    },
    "moderatorlist": {
      "rcon_command": "ModeratorList",
      "supported": true,
      "description": "Returns a list of UniqueIDs of all moderators from mods.txt.",
      "args": [],
      "notes": [],
      "example": "ModeratorList",
      "requires_args": false,
      "input_file": "IN-moderatorlist.json",
      "output_file": "OUT-moderatorlist.json"
    },
    "pausematch": {
      "rcon_command": "PauseMatch",
      "supported": true,
      "description": "Pauses the currently running match for the specified amount of seconds.",
      "args": [
        {
          "name": "amount",
          "type": "integer",
          "required": false,
          "minimum": 0,
          "maximum": 3600
        }
      ],
      "notes": [
        "The game is unpaused when amount is not specified or 0.",
        "Unpausing starts a 15 second countdown timer."
      ],
      "example": "PauseMatch 60",
      "requires_args": true,
      "input_file": "IN-pausematch.json",
      "output_file": "OUT-pausematch.json"
    },
    "refreshlist": {
      "rcon_command": "RefreshList",
      "supported": true,
      "description": "Returns a list of all connected player names and their corresponding UniqueIDs.",
      "args": [],
      "notes": [],
      "example": "RefreshList",
      "requires_args": false,
      "input_file": "IN-refreshlist.json",
      "output_file": "OUT-refreshlist.json"
    },
    "removemaprotation": {
      "rcon_command": "RemoveMapRotation",
      "supported": true,
      "description": "Removes the first occurrence of the specified map and game mode combination from the map rotation.",
      "args": [
        {
          "name": "map_name_or_id",
          "type": "string",
          "required": true
        },
        {
          "name": "game_mode",
          "type": "string",
          "required": true
        }
      ],
      "notes": [
        "MapName/ID and GameMode are case sensitive to the entries in Game.ini or MapList respectively.",
        "Writes the change to Game.ini."
      ],
      "example": "RemoveMapRotation sand snd",
      "requires_args": true,
      "input_file": "IN-removemaprotation.json",
      "output_file": "OUT-removemaprotation.json"
    },
    "removemod": {
      "rcon_command": "RemoveMod",
      "supported": true,
      "description": "Removes the specified player from the moderator list.",
      "args": [
        {
          "name": "unique_id",
          "type": "string",
          "required": true
        }
      ],
      "notes": [
        "Writes the change to mods.txt."
      ],
      "example": "RemoveMod 12345678901234567",
      "requires_args": true,
      "input_file": "IN-removemod.json",
      "output_file": "OUT-removemod.json"
    },
    "resetsnd": {
      "rcon_command": "ResetSND",
      "supported": true,
      "description": "Resets the currently running SND match.",
      "args": [],
      "notes": [
        "All players will have starting cash, no kills, deaths, assists or score.",
        "All players are killed.",
        "The score is reset to 0."
      ],
      "example": "ResetSND",
      "requires_args": false,
      "input_file": "IN-resetsnd.json",
      "output_file": "OUT-resetsnd.json"
    },
    "rotatemap": {
      "rcon_command": "RotateMap",
      "supported": true,
      "description": "Immediately changes the current map to the next map in the map rotation.",
      "args": [],
      "notes": [
        "If the current map was changed using SwitchMap, the next map will be the one after the previously switched map instead of the immediate map after the current one."
      ],
      "example": "RotateMap",
      "requires_args": false,
      "input_file": "IN-rotatemap.json",
      "output_file": "OUT-rotatemap.json"
    },
    "serverinfo": {
      "rcon_command": "ServerInfo",
      "supported": true,
      "description": "Returns server information such as server name, player count, current map and mode, and more.",
      "args": [],
      "notes": [],
      "example": "ServerInfo",
      "requires_args": false,
      "input_file": "IN-serverinfo.json",
      "output_file": "OUT-serverinfo.json"
    },
    "setbalancetableurl": {
      "rcon_command": "SetBalanceTableURL",
      "supported": true,
      "description": "Sets the balance table to load from the specified URL.",
      "args": [
        {
          "name": "github_url",
          "type": "string",
          "required": true
        }
      ],
      "notes": [
        "The URL format is user/repo/branch and must contain BalancingTable.csv.",
        "Full http/https URLs do not work.",
        "Writes to BalanceTableURL in Game.ini."
      ],
      "example": "SetBalanceTableURL vankruptgames/BalancingTable/Beta_5.1",
      "requires_args": true,
      "input_file": "IN-setbalancetableurl.json",
      "output_file": "OUT-setbalancetableurl.json"
    },
    "setbotsenabled": {
      "rcon_command": "SetBotsEnabled",
      "supported": true,
      "description": "Enables bots in the server and fills the server to the player limit with bots.",
      "args": [
        {
          "name": "enabled",
          "type": "boolean",
          "required": true
        }
      ],
      "notes": [
        "The source marks response data as missing."
      ],
      "example": "SetBotsEnabled True",
      "requires_args": true,
      "input_file": "IN-setbotsenabled.json",
      "output_file": "OUT-setbotsenabled.json"
    },
    "setcash": {
      "rcon_command": "SetCash",
      "supported": true,
      "description": "Sets the cash of the specified player to the specified amount.",
      "args": [
        {
          "name": "unique_id",
          "type": "string",
          "required": true
        },
        {
          "name": "cash_amount",
          "type": "integer",
          "required": true,
          "minimum": 0,
          "maximum": 16000
        }
      ],
      "notes": [],
      "example": "SetCash 12345678901234567 1000",
      "requires_args": true,
      "input_file": "IN-setcash.json",
      "output_file": "OUT-setcash.json"
    },
    "setlimitedammotype": {
      "rcon_command": "SetLimitedAmmoType",
      "supported": true,
      "description": "Sets the ammo limitation type.",
      "args": [
        {
          "name": "ammo_type",
          "type": "integer",
          "required": true,
          "minimum": 0,
          "maximum": 5
        }
      ],
      "notes": [
        "0=unlimited, 1=limited generic, 2=limited specific, 3=custom, 4=limited special, 5=boxless.",
        "Writes to LimitedAmmoType in Game.ini."
      ],
      "example": "SetLimitedAmmoType 0",
      "requires_args": true,
      "input_file": "IN-setlimitedammotype.json",
      "output_file": "OUT-setlimitedammotype.json"
    },
    "setmaxplayers": {
      "rcon_command": "SetMaxPlayers",
      "supported": true,
      "description": "Sets the amount of slots on the server.",
      "args": [
        {
          "name": "amount",
          "type": "integer",
          "required": true,
          "minimum": 1,
          "maximum_pcvr": 24,
          "maximum_shack": 10
        }
      ],
      "notes": [
        "Writes to MaxPlayers in Game.ini."
      ],
      "example": "SetMaxPlayers 10",
      "requires_args": true,
      "input_file": "IN-setmaxplayers.json",
      "output_file": "OUT-setmaxplayers.json"
    },
    "setpin": {
      "rcon_command": "SetPin",
      "supported": true,
      "description": "Sets the server pin to the specified pin number.",
      "args": [
        {
          "name": "pin_number",
          "type": "integer",
          "required": false,
          "minimum": 1,
          "maximum": 9999
        }
      ],
      "notes": [
        "Supplying a pin locks the server.",
        "Not supplying a pin unlocks the server.",
        "Pin values may not contain leading zeroes.",
        "Setting 0 or 0000 does not remove the pin; it sets the pin to 0.",
        "Writes to Password in Game.ini."
      ],
      "example": "SetPin 69",
      "requires_args": true,
      "input_file": "IN-setpin.json",
      "output_file": "OUT-setpin.json"
    },
    "setplayerskin": {
      "rcon_command": "SetPlayerSkin",
      "supported": true,
      "description": "Sets the player skin of the specified player.",
      "args": [
        {
          "name": "unique_id",
          "type": "string",
          "required": true
        },
        {
          "name": "skin_id",
          "type": "string",
          "required": true
        }
      ],
      "notes": [
        "The skin is automatically removed if the player leaves the server, switches teams, or upon map change."
      ],
      "example": "SetPlayerSkin 12345678901234567 kevin",
      "requires_args": true,
      "input_file": "IN-setplayerskin.json",
      "output_file": "OUT-setplayerskin.json"
    },
    "settimelimit": {
      "rcon_command": "SetTimeLimit",
      "supported": true,
      "description": "Sets the time limit of the current match to the specified amount in seconds.",
      "args": [
        {
          "name": "amount",
          "type": "integer",
          "required": true
        }
      ],
      "notes": [
        "The match will end once the time limit counts down to 0."
      ],
      "example": null,
      "requires_args": true,
      "input_file": "IN-settimelimit.json",
      "output_file": "OUT-settimelimit.json"
    },
    "shownametags": {
      "rcon_command": "ShowNametags",
      "supported": true,
      "description": "Enables or disables name tags above friendly players.",
      "args": [
        {
          "name": "enabled",
          "type": "boolean",
          "required": true
        }
      ],
      "notes": [
        "The source marks some response documentation as missing."
      ],
      "example": "ShowNametags true",
      "requires_args": true,
      "input_file": "IN-shownametags.json",
      "output_file": "OUT-shownametags.json"
    },
    "shutdownserver": {
      "rcon_command": "ShutdownServer",
      "supported": true,
      "description": "Immediately shuts down the server.",
      "args": [],
      "notes": [],
      "example": "ShutdownServer",
      "requires_args": false,
      "input_file": "IN-shutdownserver.json",
      "output_file": "OUT-shutdownserver.json"
    },
    "slap": {
      "rcon_command": "Slap",
      "supported": true,
      "description": "Deals the specified amount of damage directly to the specified player's health and ignores armor.",
      "args": [
        {
          "name": "unique_id",
          "type": "string",
          "required": true
        },
        {
          "name": "amount",
          "type": "integer",
          "required": true
        }
      ],
      "notes": [
        "Can be lethal if the amount exceeds the player's current health."
      ],
      "example": "Slap 12345678901234567 <Amount>",
      "requires_args": true,
      "input_file": "IN-slap.json",
      "output_file": "OUT-slap.json"
    },
    "switchmap": {
      "rcon_command": "SwitchMap",
      "supported": true,
      "description": "Immediately switches to the specified map and game mode.",
      "args": [
        {
          "name": "map_id",
          "type": "string",
          "required": true
        },
        {
          "name": "game_mode",
          "type": "string",
          "required": false
        }
      ],
      "notes": [
        "TDM is automatically selected if no game mode has been specified."
      ],
      "example": "SwitchMap datacenter snd",
      "requires_args": true,
      "input_file": "IN-switchmap.json",
      "output_file": "OUT-switchmap.json"
    },
    "switchteam": {
      "rcon_command": "SwitchTeam",
      "supported": true,
      "description": "Kills and moves the specified player into the specified team.",
      "args": [
        {
          "name": "unique_id",
          "type": "string",
          "required": true
        },
        {
          "name": "team_id",
          "type": "integer",
          "required": true
        }
      ],
      "notes": [
        "The player loses money, kills, deaths, assists, score, and gear as if they had just joined/switched teams."
      ],
      "example": "SwitchTeam 12345678901234567 1",
      "requires_args": true,
      "input_file": "IN-switchteam.json",
      "output_file": "OUT-switchteam.json"
    },
    "teleport": {
      "rcon_command": "Teleport",
      "supported": true,
      "description": "Teleports the specified source player to the position of the specified target player.",
      "args": [
        {
          "name": "source_unique_id",
          "type": "string",
          "required": true
        },
        {
          "name": "target_unique_id",
          "type": "string",
          "required": true
        }
      ],
      "notes": [
