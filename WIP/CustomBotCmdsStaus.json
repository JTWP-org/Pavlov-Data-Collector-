    "runssh": {
      "working": false,
      "enabled": true,
      "permission": "OWNER",
      "description": "Builds and sends the JTWP SSH security report.",
      "arguments": [],
      "requires_arguments": false,
      "example": "!runssh",
      "script": "/bin/bash",
      "script_arguments": [
        "-c",
        "bash /home/steam/jtwp-collector-data/global/ssh/buildIt > /home/steam/jtwp-collector-data/global/ssh/built.txt && bash /home/steam/jtwp-collector-data/global/ssh/discordIt"
      ],
      "sudo": false,
      "file_bridge": {
        "enabled": true,
        "input_file": "IN-runssh.json",
        "output_file": "OUT-runssh.json",
        "example_input": {}
      },
      "notes": "Runs buildIt first and then discordIt if the build succeeds."
    },

    "liveservers": {
      "working": false,
