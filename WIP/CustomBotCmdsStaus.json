{
  "version": 1,
  "description": "JTWP custom command status, arguments, permissions, and usage information.",

  "commands": {
    "restartjtwp": {
      "working": true,
      "enabled": true,
      "permission": "OWNER",
      "description": "Restarts the JTWP collector, watcher, bot, and related JTWP services.",
      "arguments": [],
      "requires_arguments": false,
      "example": "!restartjtwp",
      "script": "/usr/local/bin/restart-jtwp",
      "sudo": true,
      "file_bridge": {
        "enabled": true,
        "input_file": "IN-restartjtwp.json",
        "output_file": "OUT-restartjtwp.json",
        "example_input": {}
      },
      "notes": "May restart the Discord bot and RCON bridge while the command is executing."
    },

    "exportdata": {
      "working": false,
      "enabled": true,
      "permission": "OWNER",
      "description": "Creates a portable compressed export of JTWP collector data.",
      "arguments": [],
      "requires_arguments": false,
      "example": "!exportdata",
      "script": "/home/steam/jtwp-collector/Pavlov-Data-Collector-/scripts/export-data.py",
      "sudo": false,
      "file_bridge": {
        "enabled": true,
        "input_file": "IN-exportdata.json",
        "output_file": "OUT-exportdata.json",
        "example_input": {}
      },
      "notes": "Export may include the IP hashing secret depending on data-tool configuration."
    },

    "backupdata": {
      "working": true,
      "enabled": true,
      "permission": "OWNER",
      "description": "Creates a timestamped compressed backup of JTWP collector data.",
      "arguments": [],
      "requires_arguments": false,
      "example": "!backupdata",
      "script": "/home/steam/jtwp-collector/Pavlov-Data-Collector-/scripts/backup-data.py",
      "sudo": false,
      "file_bridge": {
        "enabled": true,
        "input_file": "IN-backupdata.json",
        "output_file": "OUT-backupdata.json",
        "example_input": {}
      },
      "notes": "Backups are intended to be stored in the configured backup output directory."
    },

    "cleardata": {
      "working": true,
      "enabled": true,
      "permission": "OWNER",
      "description": "Clears JTWP collector data using the clear-data maintenance script.",
      "arguments": [
        {
          "name": "--yes",
          "type": "flag",
          "required": true,
          "value": "--yes",
          "description": "Confirms destructive deletion without an interactive prompt."
        }
      ],
      "requires_arguments": false,
      "example": "!cleardata",
      "script": "/home/steam/jtwp-collector/Pavlov-Data-Collector-/scripts/clear-data.sh",
      "script_arguments": [
        "--yes"
      ],
      "sudo": true,
      "file_bridge": {
        "enabled": true,
        "input_file": "IN-cleardata.json",
        "output_file": "OUT-cleardata.json",
        "example_input": {}
      },
      "notes": "Destructive command. Restrict to OWNER."
    },

    "server clear-pavlov-mods pavlovserver1": {
      "working": true,
      "enabled": true,
      "permission": "OWNER",
      "description": "Clears downloaded Pavlov mods for a selected Pavlov server.",
      "arguments": [
        {
          "name": "server_id",
          "type": "string",
          "required": true,
          "description": "Configured Pavlov server ID.",
          "examples": [
            "pavlovserver",
            "pavlovserver0",
            "pavlovserver1"
          ]
        }
      ],
      "requires_arguments": true,
      "example": "!server clear-pavlov-mods pavlovserver1",
      "script": "/usr/local/bin/clear-pavlov-mods",
      "sudo": true,
      "file_bridge": {
        "enabled": true,
        "input_file": "IN-clearpavlovmods.json",
        "output_file": "OUT-clearpavlovmods.json",
        "example_input": {
          "server_id": "pavlovserver1"
        }
      },
      "notes": "The selected server ID should be validated before execution."
    },
"runcollector": {
  "working": true,
  "enabled": true,
  "permission": "OWNER",
